# Normalize line endings at commit time and prevent binary/CRLF surprises.
* text=auto

*.md      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.txt     text eol=lf
*.tape    text eol=lf

*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary
*.exe     binary
*.ico     binary
*.woff2   binary
